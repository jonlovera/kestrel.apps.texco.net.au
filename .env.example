# ── Auth.js ──────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session cookies.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# ── Texco Identity (single sign-on) ──────────────────────────────────────────
# Sign-in is delegated to identity, which performs the Microsoft Entra hop
# itself. Secrets come from https://identity.texco.net.au/applications/12/edit
# — the client secret is stored hashed there and can only be regenerated, not
# re-read, so copy it once.
#
# THE REDIRECT URI THAT MUST BE REGISTERED is derived by Auth.js from AUTH_URL,
# and is not configurable here:
#
#     {AUTH_URL}/api/auth/callback/texco-identity
#
# e.g. https://kestrel.apps.texco.net.au/api/auth/callback/texco-identity
# Register exactly that, or identity answers "invalid_client". (/auth/callback
# is also routed here for anything that still points at it, but it is not what
# this app sends.) Note https: production serves HSTS, so an http registration
# can never be reached.
IDENTITY_URL=https://identity.texco.net.au
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=
IDENTITY_WEBHOOK_SECRET=
# Only if identity serves its userinfo somewhere other than /api/user
# IDENTITY_USERINFO_PATH=/api/user
# How long a revocation may take to bite, per server instance (default 30000)
# IDENTITY_EPOCH_TTL_MS=30000

# ── Microsoft Entra ID — app-only Graph, NOT user login ──────────────────────
# These no longer sign anyone in. They are the client-credentials token behind
# the directory type-ahead on /admin/access (lib/graph.ts), which is
# independent of how users authenticate.
# From the app registration in the Texco Entra tenant (Azure portal →
# App registrations). The tenant id is what restricts sign-in to Texco staff.
# These three also power the directory type-ahead on /admin/access (via the
# client-credentials flow). That needs the Microsoft Graph "User.Read.All"
# APPLICATION permission granted + admin-consented on the app registration;
# without it the access form just falls back to typing the address by hand.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID

# ── Neon Postgres (Vercel Marketplace add-on) ────────────────────────────────
# Created automatically when you add "Neon" to the Vercel project; copy the
# value here for local dev if you want shared persistence (careful: that IS
# the production database), or leave blank locally to use the .data/*.json
# file fallback.
DATABASE_URL=

# ── Optional ─────────────────────────────────────────────────────────────────
# JSON object merged over the access config in lib/access.ts, e.g.
# {"jane.doe@texco.net.au":{"type":"state","states":["NSW"],"visibleFields":["final"]}}
# BONUS_USERS=

# Shared password for the email+password sign-in on /login. NON-PRODUCTION
# ONLY: set it for the Vercel "preview" and "development" targets, never
# production, which stays single sign-on only. The code refuses to register
# the provider when VERCEL_ENV is "production" regardless, but that is the
# backstop, not the policy. 16+ characters — anyone holding it can sign in as
# any email (what that email may then see is still lib/access.ts's call).
# Previews need it because their per-deployment URLs are not registered
# identity redirect_uris, so the SSO hop cannot complete there.
# PREVIEW_LOGIN_PASSWORD=

# Shared password for the gate every full-access admin passes before the app
# shows them anything (full access includes "View as"). Required in every
# environment that has full-access users: unset, it fails closed and locks
# them out.
# ADMIN_PASSWORD=

# Local development only: set to 1 to also enable the passwordless shortcuts
# GET /dev/login and /dev/login/{email}. Requires PREVIEW_LOGIN_PASSWORD as
# well (the shortcuts sign in through the same provider, injecting it
# server-side). Ignored outside `next dev`. NEVER set this on Vercel.
# DEV_LOGIN=1
