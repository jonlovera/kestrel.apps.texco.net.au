# ── Auth.js ──────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session cookies.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# ── Microsoft Entra ID (same convention as the tools app) ────────────────────
# From the app registration in the Texco Entra tenant (Azure portal →
# App registrations). The tenant id is what restricts sign-in to Texco staff.
# These three also power the directory type-ahead on /admin/access (via the
# client-credentials flow). That needs the Microsoft Graph "User.Read.All"
# APPLICATION permission granted + admin-consented on the app registration;
# without it the access form just falls back to typing the address by hand.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID

# ── Neon Postgres (Vercel Marketplace add-on) ────────────────────────────────
# Created automatically when you add "Neon" to the Vercel project; copy the
# value here for local dev if you want shared persistence (careful: that IS
# the production database), or leave blank locally to use the .data/*.json
# file fallback.
DATABASE_URL=

# ── Optional ─────────────────────────────────────────────────────────────────
# JSON object merged over the access config in lib/access.ts, e.g.
# {"jane.doe@texco.net.au":{"type":"state","states":["NSW"],"visibleFields":["final"]}}
# BONUS_USERS=

# Local development only: set to 1 to show an email-only dev login on /login.
# Ignored outside `next dev`. NEVER set this on Vercel.
# DEV_LOGIN=1
